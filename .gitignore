.env

# CSV imports - may contain PII / financial data
*.csv
*.CSV
Transactions/
imports/
data/

# Local config (account mappings, etc.) - may name real institutions
server/data/budget-app-mapping.json

# One-off local backfill scripts - name real institutions / are not part of the app
server/scripts/

# Node
node_modules/

# Build outputs
dist/
build/
