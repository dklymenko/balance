server/client-dist/
*.tgz

# OS
.DS_Store

# Editor
.vscode/settings.json
*.local

# Markdown is private by default. Every public document must be reviewed and
# explicitly allowlisted here and in scripts/release-hygiene-policy.mjs.
*.md
!/README.md
!/INSTALL.md
!/LICENSING.md
!/PRIVACY.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/packages/sync-client/README.md

