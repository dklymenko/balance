PORT=3001
DATABASE_URL=./data/balance.db
# Optional: directory for automated daily SQLite snapshots (~/ is expanded).
# Leave unset to disable backups.
BACKUP_DIR=~/Backups/balance
# Optional override for the private existing-ledger account/category map.
# The default is server/data/budget-app-mapping.json.
# BALANCE_BUDGET_APP_MAPPING=/absolute/path/to/budget-app-mapping.json
